# -------------------------------------------------------
# Base de données
# Utilisé par le conteneur Postgres ET pour construire DATABASE_URL
# -------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=cesiZen

# -------------------------------------------------------
# API - Authentification JWT
# -------------------------------------------------------
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_RESET_PASSWORD_SECRET=CHANGE_ME

# -------------------------------------------------------
# API - Email (Mailtrap)
# -------------------------------------------------------
MAILTRAP_USER=CHANGE_ME
MAILTRAP_PASS=CHANGE_ME

# -------------------------------------------------------
# API - URLs
# -------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
API_URL=http://localhost:3000

# -------------------------------------------------------
# API - Optionnel (valeurs par défaut si absent)
# -------------------------------------------------------
NODE_ENV=production
# API_PORT=3000          # Port exposé sur la VM (3000=staging, 3001=production si même VM)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100

# -------------------------------------------------------
# Seed automatique (staging uniquement)
# -------------------------------------------------------
AUTO_SEED=false
